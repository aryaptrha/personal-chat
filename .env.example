# Enable Dummy Mode for testing without API keys (true/false)
USE_DUMMY_MODE=true

# Your LLM Provider API Key
LLM_API_KEY=your_api_key_here
# Your LLM Base URL (e.g., https://api.openai.com/v1, https://api.groq.com/openai/v1, https://api.deepseek.com/v1, etc.)
LLM_BASE_URL=https://api.openai.com/v1
# Model Name (e.g., gpt-4o-mini, llama-3.1-70b-versatile, deepseek-chat, etc.)
LLM_MODEL=gpt-4o-mini

# Allowed CORS Origins (Comma-separated for multiple origins, e.g. http://localhost:5173,https://myvueapp.vercel.app)
CORS_ORIGIN=http://localhost:5173

