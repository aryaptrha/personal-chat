# Keep devDependencies installable even when NODE_ENV=production.
#
# npm treats NODE_ENV=production as an implicit --omit=dev. On Render that env var
# is set so the app boots with production security checks, but the build step runs
# in the same environment and needs typescript plus @types/* to compile — without
# this line `npm install && npm run build` prunes them and tsc fails with TS7016
# ("could not find a declaration file for module 'express'").
#
# `include` is the inverse of `omit`, and an explicit include wins, so this
# restores dev dependencies without giving up NODE_ENV=production at runtime.
#
# Prefer a leaner production image? Delete this file and set the host's build
# command to `npm ci --include=dev && npm run build` instead.
include=dev
