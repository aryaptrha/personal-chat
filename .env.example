# =============================================================================
# CORE
# =============================================================================

# Set to "production" on Render. This switches several checks from warning to
# hard startup failure, so an insecure deploy never goes live.
NODE_ENV=development

PORT=3000

# Enable Dummy Mode for testing without API keys (true/false)
USE_DUMMY_MODE=true

# Your LLM Provider API Key
LLM_API_KEY=your_api_key_here
# Your LLM Base URL (e.g., https://api.openai.com/v1, https://api.groq.com/openai/v1, https://api.deepseek.com/v1, etc.)
LLM_BASE_URL=https://api.openai.com/v1
# Model Name (e.g., gpt-4o-mini, llama-3.1-70b-versatile, deepseek-chat, etc.)
LLM_MODEL=gpt-4o-mini


# =============================================================================
# ORIGIN ALLOWLIST  (required in production)
# =============================================================================

# Allowed origins, comma-separated. Full origins only — no trailing slash, no path.
# e.g. http://localhost:5173,https://myportfolio.pages.dev
#
# Enforced two ways: CORS headers for browsers, plus a server-side 403 for any
# request whose Origin/Referer isn't listed. The second part is what makes a
# direct Postman or curl call fail; CORS alone never blocks non-browser clients.
#
# There is NO '*' fallback. Leave this unset in production and the server refuses
# to boot rather than silently accepting every origin.
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app, for Express `trust proxy`.
#   1 -> Render (its edge proxy terminates TLS)     <- correct for *.onrender.com
#   2 -> Cloudflare in front of Render
#   0 -> running the process directly with no proxy
#
# Getting this wrong breaks rate limiting: too low and every visitor shares one
# bucket, too high and a client can forge X-Forwarded-For for a fresh bucket per
# request. Never set this to "true".
TRUST_PROXY_HOPS=1


# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW_MINUTES=15
# Ceiling across all /api routes
RATE_LIMIT_MAX_REQUESTS=60
# Tighter ceiling for /api/chat, the only endpoint that spends money
RATE_LIMIT_CHAT_MAX_REQUESTS=20
# Burst guard so one client can't drain the whole window in a second
RATE_LIMIT_BURST_WINDOW_SECONDS=10
RATE_LIMIT_BURST_MAX_REQUESTS=3


# =============================================================================
# COST CAPS  (these bound your LLM bill even if every other layer is bypassed)
# =============================================================================

JSON_BODY_LIMIT=64kb
MAX_MESSAGES_PER_REQUEST=24
MAX_MESSAGE_CHARS=4000
MAX_TOTAL_CHARS=12000
MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60


# =============================================================================
# OPTIONAL: SHARED SECRET  (strong — recommended with a Cloudflare Worker proxy)
# =============================================================================

# When set, every /api request must send `X-API-Key: <this value>`.
# Minimum 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Only put this in a server-side caller. See examples/cloudflare-worker-proxy.js:
# the Worker holds the secret, the browser talks to the Worker, and the Render URL
# never appears in your Vue bundle. Inlining it in frontend code is pointless —
# anyone can read it from the Network tab.
# API_SHARED_SECRET=


# =============================================================================
# OPTIONAL: CLOUDFLARE TURNSTILE  (strongest option for a public frontend)
# =============================================================================

# When set, POST /api/chat requires a session token from POST /api/session, which
# is issued only after a valid Turnstile token is verified. This is the one
# control that actually distinguishes a human in a browser from a script, without
# making visitors log in. Free, and you already use Cloudflare.
# TURNSTILE_SECRET_KEY=

# HMAC key for signing session tokens. Without it a random key is generated per
# boot, so every restart or deploy invalidates outstanding sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_TOKEN_SECRET=
SESSION_TTL_MINUTES=60


# =============================================================================
# DANGEROUS — LOCAL PROMPT EXPERIMENTS ONLY
# =============================================================================

# Lets callers send their own `system` message, replacing the persona prompt.
# That turns this service into an open, unrestricted LLM proxy billed to your API
# key. Production startup refuses to boot with this enabled.
ALLOW_CLIENT_SYSTEM_PROMPT=false
